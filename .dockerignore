# FlyPic Docker 构建忽略文件

# Git
.git
.gitignore

# Node
node_modules
**/node_modules

# 前端构建产物（会重新构建）
frontend/dist

# 飞牛打包目录（不用于标准 Docker）
flypic/

# IDE 和编辑器
.vscode
.idea
*.swp
*.swo

# 日志和临时文件
*.log
*.tmp
.DS_Store
Thumbs.db

# 测试和文档
tests/
*.test.js
*.spec.js
website/
*.md
LICENSE

# 脚本目录（飞牛专用）
scripts/

# 飞牛配置
飞牛打包部署指南.md